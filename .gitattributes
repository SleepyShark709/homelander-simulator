* text=auto eol=lf
# Preserve bytes used by source, tool and asset SHA checks on every platform.
public/assets/** -text
.asset-source/** -text
scripts/vendor/mesh2motion/** -text

# glTF buffers can contain no NUL bytes near the start; always treat media as binary.
*.bin binary
*.glb binary
*.png binary
*.jpg binary
*.hdr binary
